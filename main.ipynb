      "source": [
        "# ================================================================\n",
        "# QUANTUM SECURE CHANNEL — COMPLETE MAIN EXPERIMENT\n",
        "# BB84 + QBER + EDUCATIONAL RECONCILIATION\n",
        "# + TOEPLITZ PRIVACY AMPLIFICATION + AES-256-GCM\n",
        "#\n",
        "# Processor A: 5 qubits\n",
        "# Processor B: 7 qubits\n",
        "#\n",
        "# OUTPUT:\n",
        "# results/\n",
        "#   security_report.json\n",
        "#   figures/\n",
        "#   tables/\n",
        "#\n",
        "# Run this entire cell after restarting the Jupyter kernel.\n",
        "# ================================================================\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 1. IMPORTS\n",
        "# ================================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import time\n",
        "import hmac\n",
        "import hashlib\n",
        "import secrets\n",
        "import warnings\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from datetime import datetime, timezone\n",
        "\n",
        "from qiskit import QuantumCircuit, transpile\n",
        "from qiskit_aer import AerSimulator\n",
        "\n",
        "from qiskit_aer.noise import (\n",
        "    NoiseModel,\n",
        "    depolarizing_error,\n",
        "    ReadoutError\n",
        ")\n",
        "\n",
        "from cryptography.hazmat.primitives.ciphers.aead import AESGCM\n",
        "\n",
        "from processors.hardware import (\n",
        "    get_processor_a,\n",
        "    get_processor_b\n",
        ")\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 2. EXPERIMENT CONFIGURATION\n",
        "# ================================================================\n",
        "\n",
        "MESSAGE_BITS = 12000\n",
        "\n",
        "# Increased comparison size to provide more key material.\n",
        "COMPARISON_BITS = 10000\n",
        "\n",
        "COMPARISON_TRIALS = 3\n",
        "\n",
        "TEST_FRACTION = 0.20\n",
        "\n",
        "QBER_ABORT_THRESHOLD = 0.11\n",
        "\n",
        "AES_KEY_BITS = 256\n",
        "AES_KEY_BYTES = 32\n",
        "\n",
        "RANDOM_SEED = None\n",
        "\n",
        "# Local authentication key for this educational demonstration.\n",
        "# This is not a replacement for a production authentication setup.\n",
        "AUTH_PSK = secrets.token_bytes(32)\n",
        "\n",
        "rng = np.random.default_rng(RANDOM_SEED)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 3. OUTPUT DIRECTORIES\n",
        "# ================================================================\n",
        "\n",
        "RESULTS_DIR = \"results\"\n",
        "\n",
        "FIGURES_DIR = os.path.join(\n",
        "    RESULTS_DIR,\n",
        "    \"figures\"\n",
        ")\n",
        "\n",
        "TABLES_DIR = os.path.join(\n",
        "    RESULTS_DIR,\n",
        "    \"tables\"\n",
        ")\n",
        "\n",
        "os.makedirs(RESULTS_DIR, exist_ok=True)\n",
        "os.makedirs(FIGURES_DIR, exist_ok=True)\n",
        "os.makedirs(TABLES_DIR, exist_ok=True)\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"QUANTUM SECURE CHANNEL EXPERIMENT\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"Results directory:\", RESULTS_DIR)\n",
        "print(\"Figures directory:\", FIGURES_DIR)\n",
        "print(\"Tables directory:\", TABLES_DIR)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 4. LOAD PROCESSORS\n",
        "# ================================================================\n",
        "\n",
        "processor_a = get_processor_a()\n",
        "processor_b = get_processor_b()\n",
        "\n",
        "processors = {\n",
        "    \"Processor A\": processor_a,\n",
        "    \"Processor B\": processor_b\n",
        "}\n",
        "\n",
        "required_fields = [\n",
        "    \"name\",\n",
        "    \"qubits\",\n",
        "    \"backend\",\n",
        "    \"noise_model\"\n",
        "]\n",
        "\n",
        "for processor_name, processor in processors.items():\n",
        "\n",
        "    for field in required_fields:\n",
        "\n",
        "        if field not in processor:\n",
        "            raise KeyError(\n",
        "                f\"{processor_name} is missing '{field}'.\"\n",
        "            )\n",
        "\n",
        "    if int(processor[\"qubits\"]) < 1:\n",
        "        raise ValueError(\n",
        "            f\"{processor_name} has an invalid qubit count.\"\n",
        "        )\n",
        "\n",
        "    print(\n",
        "        f\"\\n{processor_name}: \"\n",
        "        f\"{processor['name']} | \"\n",
        "        f\"{processor['qubits']} qubits\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 5. CONTROLLED NOISE MODEL\n",
        "# ================================================================\n",
        "\n",
        "def get_controlled_noise_model():\n",
        "\n",
        "    noise_model = NoiseModel()\n",
        "\n",
        "    single_qubit_error = depolarizing_error(\n",
        "        0.005,\n",
        "        1\n",
        "    )\n",
        "\n",
        "    readout_error = ReadoutError([\n",
        "        [0.98, 0.02],\n",
        "        [0.02, 0.98]\n",
        "    ])\n",
        "\n",
        "    for gate in [\"x\", \"sx\", \"h\"]:\n",
        "\n",
        "        noise_model.add_all_qubit_quantum_error(\n",
        "            single_qubit_error,\n",
        "            gate\n",
        "        )\n",
        "\n",
        "    noise_model.add_all_qubit_readout_error(\n",
        "        readout_error\n",
        "    )\n",
        "\n",
        "    return noise_model\n",
        "\n",
        "\n",
        "CONTROLLED_NOISE_MODEL = get_controlled_noise_model()\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 6. GENERAL HELPER FUNCTIONS\n",
        "# ================================================================\n",
        "\n",
        "def binary_entropy(probability):\n",
        "\n",
        "    if probability <= 0 or probability >= 1:\n",
        "        return 0.0\n",
        "\n",
        "    return (\n",
        "        -probability * np.log2(probability)\n",
        "        -(1 - probability) * np.log2(1 - probability)\n",
        "    )\n",
        "\n",
        "\n",
        "def calculate_qber(alice_bits, bob_bits):\n",
        "\n",
        "    if len(alice_bits) == 0:\n",
        "        raise ValueError(\"Cannot calculate QBER from zero bits.\")\n",
        "\n",
        "    errors = np.sum(\n",
        "        np.asarray(alice_bits) != np.asarray(bob_bits)\n",
        "    )\n",
        "\n",
        "    return float(errors / len(alice_bits))\n",
        "\n",
        "\n",
        "def pack_key_bits(key_bits):\n",
        "\n",
        "    key_bits = np.asarray(\n",
        "        key_bits,\n",
        "        dtype=np.uint8\n",
        "    ).reshape(-1)\n",
        "\n",
        "    if len(key_bits) != AES_KEY_BITS:\n",
        "        raise ValueError(\n",
        "            f\"AES-256 requires {AES_KEY_BITS} bits. \"\n",
        "            f\"Received {len(key_bits)}.\"\n",
        "        )\n",
        "\n",
        "    if not np.all(\n",
        "        (key_bits == 0) | (key_bits == 1)\n",
        "    ):\n",
        "        raise ValueError(\n",
        "            \"Key contains non-binary values.\"\n",
        "        )\n",
        "\n",
        "    packed_key = np.packbits(\n",
        "        key_bits\n",
        "    ).tobytes()\n",
        "\n",
        "    if len(packed_key) != AES_KEY_BYTES:\n",
        "        raise ValueError(\n",
        "            \"Packed key is not exactly 32 bytes.\"\n",
        "        )\n",
        "\n",
        "    return packed_key\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 7. BB84 CIRCUIT GENERATION\n",
        "# ================================================================\n",
        "\n",
        "def generate_bb84_circuit(\n",
        "    alice_bits,\n",
        "    alice_bases,\n",
        "    bob_bases\n",
        "):\n",
        "\n",
        "    number_of_qubits = len(alice_bits)\n",
        "\n",
        "    circuit = QuantumCircuit(\n",
        "        number_of_qubits,\n",
        "        number_of_qubits\n",
        "    )\n",
        "\n",
        "    for i in range(number_of_qubits):\n",
        "\n",
        "        # Alice prepares the state.\n",
        "        if alice_bits[i] == 1:\n",
        "            circuit.x(i)\n",
        "\n",
        "        # Alice selects the diagonal basis.\n",
        "        if alice_bases[i] == 1:\n",
        "            circuit.h(i)\n",
        "\n",
        "        # Bob selects his measurement basis.\n",
        "        if bob_bases[i] == 1:\n",
        "            circuit.h(i)\n",
        "\n",
        "        circuit.measure(i, i)\n",
        "\n",
        "    return circuit\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 8. QUANTUM TRANSMISSION\n",
        "# ================================================================\n",
        "\n",
        "def transmit_bb84(\n",
        "    processor,\n",
        "    number_of_bits,\n",
        "    noise_model=None\n",
        "):\n",
        "\n",
        "    start_time = time.perf_counter()\n",
        "\n",
        "    processor_qubits = int(\n",
        "        processor[\"qubits\"]\n",
        "    )\n",
        "\n",
        "    backend = processor[\"backend\"]\n",
        "\n",
        "    # Alice generates random bits and bases.\n",
        "    alice_bits = rng.integers(\n",
        "        0,\n",
        "        2,\n",
        "        size=number_of_bits,\n",
        "        dtype=np.uint8\n",
        "    )\n",
        "\n",
        "    alice_bases = rng.integers(\n",
        "        0,\n",
        "        2,\n",
        "        size=number_of_bits,\n",
        "        dtype=np.uint8\n",
        "    )\n",
        "\n",
        "    # Bob independently generates measurement bases.\n",
        "    bob_bases = rng.integers(\n",
        "        0,\n",
        "        2,\n",
        "        size=number_of_bits,\n",
        "        dtype=np.uint8\n",
        "    )\n",
        "\n",
        "    circuits = []\n",
        "\n",
        "    # Divide the transmission into batches that fit\n",
        "    # within the processor's available qubit count.\n",
        "    for start in range(\n",
        "        0,\n",
        "        number_of_bits,\n",
        "        processor_qubits\n",
        "    ):\n",
        "\n",
        "        end = min(\n",
        "            start + processor_qubits,\n",
        "            number_of_bits\n",
        "        )\n",
        "\n",
        "        circuit = generate_bb84_circuit(\n",
        "            alice_bits[start:end],\n",
        "            alice_bases[start:end],\n",
        "            bob_bases[start:end]\n",
        "        )\n",
        "\n",
        "        circuits.append(circuit)\n",
        "\n",
        "    batch_count = len(circuits)\n",
        "\n",
        "    # Transpile for the selected processor backend.\n",
        "    transpiled_circuits = transpile(\n",
        "        circuits,\n",
        "        backend=backend,\n",
        "        optimization_level=1\n",
        "    )\n",
        "\n",
        "    if not isinstance(transpiled_circuits, list):\n",
        "        transpiled_circuits = [transpiled_circuits]\n",
        "\n",
        "    # Execute using AerSimulator.\n",
        "    simulator = AerSimulator(\n",
        "        noise_model=noise_model\n",
        "    )\n",
        "\n",
        "    job = simulator.run(\n",
        "        transpiled_circuits,\n",
        "        shots=1\n",
        "    )\n",
        "\n",
        "    result = job.result()\n",
        "\n",
        "    bob_bits = []\n",
        "\n",
        "    total_depth = 0\n",
        "    total_one_qubit_gates = 0\n",
        "    total_two_qubit_gates = 0\n",
        "    total_gate_count = 0\n",
        "\n",
        "    for circuit_index, circuit in enumerate(\n",
        "        transpiled_circuits\n",
        "    ):\n",
        "\n",
        "        counts = result.get_counts(\n",
        "            circuit_index\n",
        "        )\n",
        "\n",
        "        measured_string = next(\n",
        "            iter(counts)\n",
        "        )\n",
        "\n",
        "        measured_string = (\n",
        "            measured_string\n",
        "            .replace(\" \", \"\")\n",
        "            [::-1]\n",
        "        )\n",
        "\n",
        "        circuit_bits = [\n",
        "            int(bit)\n",
        "            for bit in measured_string\n",
        "        ]\n",
        "\n",
        "        if len(circuit_bits) != circuit.num_clbits:\n",
        "            raise ValueError(\n",
        "                \"Measurement result length does not match \"\n",
        "                \"the circuit's classical register.\"\n",
        "            )\n",
        "\n",
        "        bob_bits.extend(circuit_bits)\n",
        "\n",
        "        total_depth += circuit.depth()\n",
        "\n",
        "        operations = circuit.count_ops()\n",
        "\n",
        "        for operation, count in operations.items():\n",
        "\n",
        "            operation = str(operation)\n",
        "\n",
        "            if operation in [\n",
        "                \"measure\",\n",
        "                \"barrier\",\n",
        "                \"delay\"\n",
        "            ]:\n",
        "                continue\n",
        "\n",
        "            total_gate_count += count\n",
        "\n",
        "            if operation in [\n",
        "                \"x\",\n",
        "                \"sx\",\n",
        "                \"h\",\n",
        "                \"rz\",\n",
        "                \"u\",\n",
        "                \"u1\",\n",
        "                \"u2\",\n",
        "                \"u3\"\n",
        "            ]:\n",
        "\n",
        "                total_one_qubit_gates += count\n",
        "\n",
        "            elif operation in [\n",
        "                \"cx\",\n",
        "                \"cz\",\n",
        "                \"ecr\",\n",
        "                \"swap\",\n",
        "                \"iswap\"\n",
        "            ]:\n",
        "\n",
        "                total_two_qubit_gates += count\n",
        "\n",
        "    bob_bits = np.asarray(\n",
        "        bob_bits[:number_of_bits],\n",
        "        dtype=np.uint8\n",
        "    )\n",
        "\n",
        "    if len(bob_bits) != number_of_bits:\n",
        "        raise ValueError(\n",
        "            \"Bob's measurement output has an unexpected length.\"\n",
        "        )\n",
        "\n",
        "    elapsed_time = (\n",
        "        time.perf_counter() - start_time\n",
        "    )\n",
        "\n",
        "    metrics = {\n",
        "\n",
        "        \"batch_count\": batch_count,\n",
        "\n",
        "        \"average_circuit_depth\":\n",
        "            total_depth / max(batch_count, 1),\n",
        "\n",
        "        \"one_qubit_gate_count\":\n",
        "            total_one_qubit_gates,\n",
        "\n",
        "        \"two_qubit_gate_count\":\n",
        "            total_two_qubit_gates,\n",
        "\n",
        "        \"total_gate_count\":\n",
        "            total_gate_count,\n",
        "\n",
        "        \"execution_time_seconds\":\n",
        "            elapsed_time\n",
        "    }\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"alice_bits\": alice_bits,\n",
        "\n",
        "        \"alice_bases\": alice_bases,\n",
        "\n",
        "        \"bob_bases\": bob_bases,\n",
        "\n",
        "        \"bob_bits\": bob_bits,\n",
        "\n",
        "        \"metrics\": metrics\n",
        "    }\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 9. BB84 SIFTING\n",
        "# ================================================================\n",
        "\n",
        "def sift_key(\n",
        "    alice_bits,\n",
        "    alice_bases,\n",
        "    bob_bases,\n",
        "    bob_bits\n",
        "):\n",
        "\n",
        "    matching_positions = np.where(\n",
        "        alice_bases == bob_bases\n",
        "    )[0]\n",
        "\n",
        "    sifted_alice = alice_bits[\n",
        "        matching_positions\n",
        "    ]\n",
        "\n",
        "    sifted_bob = bob_bits[\n",
        "        matching_positions\n",
        "    ]\n",
        "\n",
        "    return (\n",
        "        sifted_alice,\n",
        "        sifted_bob,\n",
        "        matching_positions\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 10. QBER ESTIMATION\n",
        "# ================================================================\n",
        "\n",
        "def estimate_qber(\n",
        "    alice_bits,\n",
        "    bob_bits,\n",
        "    test_fraction=TEST_FRACTION\n",
        "):\n",
        "\n",
        "    total_bits = len(alice_bits)\n",
        "\n",
        "    if total_bits < 10:\n",
        "        raise ValueError(\n",
        "            \"Insufficient sifted bits for QBER estimation.\"\n",
        "        )\n",
        "\n",
        "    sample_size = max(\n",
        "        1,\n",
        "        int(total_bits * test_fraction)\n",
        "    )\n",
        "\n",
        "    sample_indices = rng.choice(\n",
        "        total_bits,\n",
        "        size=sample_size,\n",
        "        replace=False\n",
        "    )\n",
        "\n",
        "    remaining_mask = np.ones(\n",
        "        total_bits,\n",
        "        dtype=bool\n",
        "    )\n",
        "\n",
        "    remaining_mask[sample_indices] = False\n",
        "\n",
        "    sample_alice = alice_bits[\n",
        "        sample_indices\n",
        "    ]\n",
        "\n",
        "    sample_bob = bob_bits[\n",
        "        sample_indices\n",
        "    ]\n",
        "\n",
        "    qber = calculate_qber(\n",
        "        sample_alice,\n",
        "        sample_bob\n",
        "    )\n",
        "\n",
        "    remaining_alice = alice_bits[\n",
        "        remaining_mask\n",
        "    ]\n",
        "\n",
        "    remaining_bob = bob_bits[\n",
        "        remaining_mask\n",
        "    ]\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"qber\": qber,\n",
        "\n",
        "        \"sample_size\": sample_size,\n",
        "\n",
        "        \"remaining_alice\": remaining_alice,\n",
        "\n",
        "        \"remaining_bob\": remaining_bob\n",
        "    }\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 11. EDUCATIONAL ERROR RECONCILIATION\n",
        "# ================================================================\n",
        "\n",
        "def reconcile_keys(\n",
        "    alice_bits,\n",
        "    bob_bits\n",
        "):\n",
        "\n",
        "    alice_bits = np.asarray(\n",
        "        alice_bits,\n",
        "        dtype=np.uint8\n",
        "    ).copy()\n",
        "\n",
        "    bob_bits = np.asarray(\n",
        "        bob_bits,\n",
        "        dtype=np.uint8\n",
        "    ).copy()\n",
        "\n",
        "    if len(alice_bits) != len(bob_bits):\n",
        "        raise ValueError(\n",
        "            \"Alice and Bob key lengths differ.\"\n",
        "        )\n",
        "\n",
        "    mismatch_positions = np.where(\n",
        "        alice_bits != bob_bits\n",
        "    )[0]\n",
        "\n",
        "    corrected_bob = bob_bits.copy()\n",
        "\n",
        "    # Simplified educational reconciliation:\n",
        "    # Alice reveals her values at mismatch positions.\n",
        "    for position in mismatch_positions:\n",
        "\n",
        "        corrected_bob[position] = alice_bits[position]\n",
        "\n",
        "    if not np.array_equal(\n",
        "        alice_bits,\n",
        "        corrected_bob\n",
        "    ):\n",
        "        raise ValueError(\n",
        "            \"Error reconciliation did not produce matching strings.\"\n",
        "        )\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"alice_key\": alice_bits,\n",
        "\n",
        "        \"bob_key\": corrected_bob,\n",
        "\n",
        "        \"corrected_errors\": len(mismatch_positions),\n",
        "\n",
        "        \"leakage_bits\": len(mismatch_positions)\n",
        "    }\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 12. TOEPLITZ PRIVACY AMPLIFICATION\n",
        "# ================================================================\n",
        "\n",
        "def toeplitz_hash(\n",
        "    input_bits,\n",
        "    output_length=AES_KEY_BITS,\n",
        "    seed=None\n",
        "):\n",
        "\n",
        "    input_bits = np.asarray(\n",
        "        input_bits,\n",
        "        dtype=np.uint8\n",
        "    ).reshape(-1)\n",
        "\n",
        "    n = len(input_bits)\n",
        "    m = int(output_length)\n",
        "\n",
        "    if n < m:\n",
        "        raise ValueError(\n",
        "            f\"Input too short: {n} bits available; \"\n",
        "            f\"{m} bits required.\"\n",
        "        )\n",
        "\n",
        "    seed_length = n + m - 1\n",
        "\n",
        "    # A single seed is generated if none is supplied.\n",
        "    if seed is None:\n",
        "\n",
        "        seed = rng.integers(\n",
        "            0,\n",
        "            2,\n",
        "            size=seed_length,\n",
        "            dtype=np.uint8\n",
        "        )\n",
        "\n",
        "    seed = np.asarray(\n",
        "        seed,\n",
        "        dtype=np.uint8\n",
        "    ).reshape(-1)\n",
        "\n",
        "    if len(seed) != seed_length:\n",
        "        raise ValueError(\n",
        "            f\"Invalid Toeplitz seed length: {len(seed)}. \"\n",
        "            f\"Expected {seed_length}.\"\n",
        "        )\n",
        "\n",
        "    if not np.all(\n",
        "        (seed == 0) | (seed == 1)\n",
        "    ):\n",
        "        raise ValueError(\n",
        "            \"Toeplitz seed must contain only binary values.\"\n",
        "        )\n",
        "\n",
        "    row_indices = np.arange(m).reshape(m, 1)\n",
        "\n",
        "    column_indices = np.arange(n).reshape(1, n)\n",
        "\n",
        "    indices = (\n",
        "        n - 1\n",
        "        + row_indices\n",
        "        - column_indices\n",
        "    )\n",
        "\n",
        "    if (\n",
        "        indices.min() < 0\n",
        "        or indices.max() >= len(seed)\n",
        "    ):\n",
        "\n",
        "        raise RuntimeError(\n",
        "            \"Toeplitz indexing error: \"\n",
        "            f\"min={indices.min()}, \"\n",
        "            f\"max={indices.max()}, \"\n",
        "            f\"seed length={len(seed)}.\"\n",
        "        )\n",
        "\n",
        "    matrix = seed[indices]\n",
        "\n",
        "    output_bits = (\n",
        "        matrix.astype(np.int64)\n",
        "        @ input_bits.astype(np.int64)\n",
        "    ) % 2\n",
        "\n",
        "    return output_bits.astype(np.uint8)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 13. FINAL KEY LENGTH ESTIMATION\n",
        "# ================================================================\n",
        "\n",
        "def estimate_final_key_length(\n",
        "    remaining_bits,\n",
        "    qber,\n",
        "    leakage_bits\n",
        "):\n",
        "\n",
        "    entropy = binary_entropy(qber)\n",
        "\n",
        "    estimated_length = (\n",
        "        remaining_bits\n",
        "        - 2 * remaining_bits * entropy\n",
        "        - leakage_bits\n",
        "        - 128\n",
        "    )\n",
        "\n",
        "    return max(\n",
        "        0,\n",
        "        int(np.floor(estimated_length))\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 14. TRANSCRIPT AUTHENTICATION DEMONSTRATION\n",
        "# ================================================================\n",
        "\n",
        "def authenticate_transcript(transcript):\n",
        "\n",
        "    transcript_bytes = transcript.encode(\n",
        "        \"utf-8\"\n",
        "    )\n",
        "\n",
        "    tag = hmac.new(\n",
        "        AUTH_PSK,\n",
        "        transcript_bytes,\n",
        "        hashlib.sha256\n",
        "    ).digest()\n",
        "\n",
        "    verification_tag = hmac.new(\n",
        "        AUTH_PSK,\n",
        "        transcript_bytes,\n",
        "        hashlib.sha256\n",
        "    ).digest()\n",
        "\n",
        "    return hmac.compare_digest(\n",
        "        tag,\n",
        "        verification_tag\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 15. FINAL KEY CONFIRMATION\n",
        "# ================================================================\n",
        "\n",
        "def confirm_final_keys(\n",
        "    alice_key_bits,\n",
        "    bob_key_bits\n",
        "):\n",
        "\n",
        "    alice_key = pack_key_bits(\n",
        "        alice_key_bits\n",
        "    )\n",
        "\n",
        "    bob_key = pack_key_bits(\n",
        "        bob_key_bits\n",
        "    )\n",
        "\n",
        "    alice_confirmation = hmac.new(\n",
        "        alice_key,\n",
        "        b\"BB84-key-confirmation\",\n",
        "        hashlib.sha256\n",
        "    ).digest()\n",
        "\n",
        "    bob_confirmation = hmac.new(\n",
        "        bob_key,\n",
        "        b\"BB84-key-confirmation\",\n",
        "        hashlib.sha256\n",
        "    ).digest()\n",
        "\n",
        "    return hmac.compare_digest(\n",
        "        alice_confirmation,\n",
        "        bob_confirmation\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 16. AES-256-GCM ENCRYPTION\n",
        "# ================================================================\n",
        "\n",
        "def encrypt_message(\n",
        "    message,\n",
        "    key_bits\n",
        "):\n",
        "\n",
        "    key = pack_key_bits(\n",
        "        key_bits\n",
        "    )\n",
        "\n",
        "    aesgcm = AESGCM(key)\n",
        "\n",
        "    nonce = secrets.token_bytes(12)\n",
        "\n",
        "    ciphertext = aesgcm.encrypt(\n",
        "        nonce,\n",
        "        message.encode(\"utf-8\"),\n",
        "        None\n",
        "    )\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"nonce\": nonce,\n",
        "\n",
        "        \"ciphertext\": ciphertext\n",
        "    }\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 17. AES-256-GCM DECRYPTION\n",
        "# ================================================================\n",
        "\n",
        "def decrypt_message(\n",
        "    encrypted_data,\n",
        "    key_bits\n",
        "):\n",
        "\n",
        "    key = pack_key_bits(\n",
        "        key_bits\n",
        "    )\n",
        "\n",
        "    aesgcm = AESGCM(key)\n",
        "\n",
        "    plaintext = aesgcm.decrypt(\n",
        "        encrypted_data[\"nonce\"],\n",
        "        encrypted_data[\"ciphertext\"],\n",
        "        None\n",
        "    )\n",
        "\n",
        "    return plaintext.decode(\"utf-8\")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 18. COMPLETE QKD SESSION\n",
        "# ================================================================\n",
        "\n",
        "def run_qkd_session(\n",
        "    processor,\n",
        "    number_of_bits,\n",
        "    noise_model=None\n",
        "):\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Quantum transmission\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    transmission = transmit_bb84(\n",
        "        processor,\n",
        "        number_of_bits,\n",
        "        noise_model\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Sifting\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    sifted_alice, sifted_bob, matching_positions = (\n",
        "        sift_key(\n",
        "            transmission[\"alice_bits\"],\n",
        "            transmission[\"alice_bases\"],\n",
        "            transmission[\"bob_bases\"],\n",
        "            transmission[\"bob_bits\"]\n",
        "        )\n",
        "    )\n",
        "\n",
        "    if len(sifted_alice) < AES_KEY_BITS + 150:\n",
        "        raise ValueError(\n",
        "            \"Insufficient sifted bits for key generation.\"\n",
        "        )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # QBER estimation\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    qber_result = estimate_qber(\n",
        "        sifted_alice,\n",
        "        sifted_bob\n",
        "    )\n",
        "\n",
        "    qber = qber_result[\"qber\"]\n",
        "\n",
        "    if qber > QBER_ABORT_THRESHOLD:\n",
        "        raise ValueError(\n",
        "            f\"QBER {qber:.4f} exceeds threshold \"\n",
        "            f\"{QBER_ABORT_THRESHOLD:.2f}.\"\n",
        "        )\n",
        "\n",
        "    remaining_alice = qber_result[\n",
        "        \"remaining_alice\"\n",
        "    ]\n",
        "\n",
        "    remaining_bob = qber_result[\n",
        "        \"remaining_bob\"\n",
        "    ]\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Error reconciliation\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    reconciliation = reconcile_keys(\n",
        "        remaining_alice,\n",
        "        remaining_bob\n",
        "    )\n",
        "\n",
        "    alice_reconciled = reconciliation[\n",
        "        \"alice_key\"\n",
        "    ]\n",
        "\n",
        "    bob_reconciled = reconciliation[\n",
        "        \"bob_key\"\n",
        "    ]\n",
        "\n",
        "    if not np.array_equal(\n",
        "        alice_reconciled,\n",
        "        bob_reconciled\n",
        "    ):\n",
        "        raise ValueError(\n",
        "            \"Reconciliation failed: keys do not match.\"\n",
        "        )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Key length estimation\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    estimated_key_length = estimate_final_key_length(\n",
        "        len(alice_reconciled),\n",
        "        qber,\n",
        "        reconciliation[\"leakage_bits\"]\n",
        "    )\n",
        "\n",
        "    if estimated_key_length < AES_KEY_BITS:\n",
        "        raise ValueError(\n",
        "            \"Estimated secure key length is insufficient \"\n",
        "            f\"({estimated_key_length} bits available; \"\n",
        "            f\"{AES_KEY_BITS} required).\"\n",
        "        )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Privacy amplification\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    input_length = len(alice_reconciled)\n",
        "\n",
        "    # One shared public Toeplitz seed.\n",
        "    # Both parties use this exact same seed.\n",
        "    toeplitz_seed = rng.integers(\n",
        "        0,\n",
        "        2,\n",
        "        size=input_length + AES_KEY_BITS - 1,\n",
        "        dtype=np.uint8\n",
        "    )\n",
        "\n",
        "    alice_final_key = toeplitz_hash(\n",
        "        alice_reconciled,\n",
        "        AES_KEY_BITS,\n",
        "        seed=toeplitz_seed\n",
        "    )\n",
        "\n",
        "    bob_final_key = toeplitz_hash(\n",
        "        bob_reconciled,\n",
        "        AES_KEY_BITS,\n",
        "        seed=toeplitz_seed\n",
        "    )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Verify final keys\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    if not np.array_equal(\n",
        "        alice_final_key,\n",
        "        bob_final_key\n",
        "    ):\n",
        "        raise ValueError(\n",
        "            \"Privacy amplification failed: final keys differ.\"\n",
        "        )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Key confirmation\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    key_confirmation = confirm_final_keys(\n",
        "        alice_final_key,\n",
        "        bob_final_key\n",
        "    )\n",
        "\n",
        "    if not key_confirmation:\n",
        "        raise ValueError(\n",
        "            \"Alice and Bob final key confirmation failed.\"\n",
        "        )\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # Transcript authentication demonstration\n",
        "    # ------------------------------------------------------------\n",
        "\n",
        "    transcript = (\n",
        "        f\"Processor={processor['name']};\"\n",
        "        f\"QBER={qber:.6f};\"\n",
        "        f\"Sifted={len(sifted_alice)};\"\n",
        "        f\"FinalKey={AES_KEY_BITS}\"\n",
        "    )\n",
        "\n",
        "    authentication_success = authenticate_transcript(\n",
        "        transcript\n",
        "    )\n",
        "\n",
        "    if not authentication_success:\n",
        "        raise ValueError(\n",
        "            \"Transcript authentication failed.\"\n",
        "        )\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"qber\": qber,\n",
        "\n",
        "        \"sifted_bits\": len(sifted_alice),\n",
        "\n",
        "        \"sample_size\": qber_result[\"sample_size\"],\n",
        "\n",
        "        \"remaining_bits\": len(alice_reconciled),\n",
        "\n",
        "        \"corrected_errors\":\n",
        "            reconciliation[\"corrected_errors\"],\n",
        "\n",
        "        \"leakage_bits\":\n",
        "            reconciliation[\"leakage_bits\"],\n",
        "\n",
        "        \"estimated_key_length\":\n",
        "            estimated_key_length,\n",
        "\n",
        "        \"final_key_length\":\n",
        "            len(alice_final_key),\n",
        "\n",
        "        \"alice_key\": alice_final_key,\n",
        "\n",
        "        \"bob_key\": bob_final_key,\n",
        "\n",
        "        \"key_confirmation\": key_confirmation,\n",
        "\n",
        "        \"authentication_success\":\n",
        "            authentication_success,\n",
        "\n",
        "        \"metrics\": transmission[\"metrics\"]\n",
        "    }\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 19. INDEPENDENT TOEPLITZ TEST\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"TESTING TOEPLITZ PRIVACY AMPLIFICATION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "test_alice_bits = rng.integers(\n",
        "    0,\n",
        "    2,\n",
        "    size=6000,\n",
        "    dtype=np.uint8\n",
        ")\n",
        "\n",
        "test_bob_bits = test_alice_bits.copy()\n",
        "\n",
        "test_seed = rng.integers(\n",
        "    0,\n",
        "    2,\n",
        "    size=6000 + AES_KEY_BITS - 1,\n",
        "    dtype=np.uint8\n",
        ")\n",
        "\n",
        "test_alice_key = toeplitz_hash(\n",
        "    test_alice_bits,\n",
        "    AES_KEY_BITS,\n",
        "    seed=test_seed\n",
        ")\n",
        "\n",
        "test_bob_key = toeplitz_hash(\n",
        "    test_bob_bits,\n",
        "    AES_KEY_BITS,\n",
        "    seed=test_seed\n",
        ")\n",
        "\n",
        "assert np.array_equal(\n",
        "    test_alice_key,\n",
        "    test_bob_key\n",
        ")\n",
        "\n",
        "assert len(\n",
        "    pack_key_bits(test_alice_key)\n",
        ") == AES_KEY_BYTES\n",
        "\n",
        "print(\"Toeplitz test: PASSED\")\n",
        "print(\"Alice/Bob keys match: YES\")\n",
        "print(\"AES key size: 256 bits / 32 bytes\")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 20. USER MESSAGE INPUT\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"MESSAGE INPUT\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "USER_MESSAGE = input(\n",
        "    \"\\nEnter the message to transmit securely:\\n> \"\n",
        ")\n",
        "\n",
        "if not USER_MESSAGE.strip():\n",
        "    raise ValueError(\n",
        "        \"Message cannot be empty.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nMessage accepted.\")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 21. MESSAGE TRANSMISSION THROUGH BOTH PROCESSORS\n",
        "# ================================================================\n",
        "\n",
        "message_delivery_results = []\n",
        "message_session_summary = []\n",
        "\n",
        "message_sessions = {}\n",
        "\n",
        "for processor_name, processor in processors.items():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"MESSAGE SESSION:\", processor_name)\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    try:\n",
        "\n",
        "        # Message sessions use the processor's own noise model.\n",
        "        session = run_qkd_session(\n",
        "            processor,\n",
        "            MESSAGE_BITS,\n",
        "            processor[\"noise_model\"]\n",
        "        )\n",
        "\n",
        "        encrypted_data = encrypt_message(\n",
        "            USER_MESSAGE,\n",
        "            session[\"alice_key\"]\n",
        "        )\n",
        "\n",
        "        decrypted_message = decrypt_message(\n",
        "            encrypted_data,\n",
        "            session[\"bob_key\"]\n",
        "        )\n",
        "\n",
        "        delivery_success = (\n",
        "            decrypted_message == USER_MESSAGE\n",
        "        )\n",
        "\n",
        "        if not delivery_success:\n",
        "            raise ValueError(\n",
        "                \"Decrypted message differs from original.\"\n",
        "            )\n",
        "\n",
        "        message_sessions[processor_name] = session\n",
        "\n",
        "        message_delivery_results.append({\n",
        "\n",
        "            \"processor\": processor_name,\n",
        "\n",
        "            \"message_characters\": len(USER_MESSAGE),\n",
        "\n",
        "            \"message_bytes\": len(\n",
        "                USER_MESSAGE.encode(\"utf-8\")\n",
        "            ),\n",
        "\n",
        "            \"ciphertext_bytes\": len(\n",
        "                encrypted_data[\"ciphertext\"]\n",
        "            ),\n",
        "\n",
        "            \"encryption\": \"AES-256-GCM\",\n",
        "\n",
        "            \"key_length_bits\":\n",
        "                session[\"final_key_length\"],\n",
        "\n",
        "            \"qber\": session[\"qber\"],\n",
        "\n",
        "            \"delivery_success\": True,\n",
        "\n",
        "            \"authentication_success\":\n",
        "                session[\"authentication_success\"],\n",
        "\n",
        "            \"key_confirmation\":\n",
        "                session[\"key_confirmation\"],\n",
        "\n",
        "            \"error\": None\n",
        "        })\n",
        "\n",
        "        message_session_summary.append({\n",
        "\n",
        "            \"processor\": processor_name,\n",
        "\n",
        "            \"qubits\": processor[\"qubits\"],\n",
        "\n",
        "            \"qber\": session[\"qber\"],\n",
        "\n",
        "            \"sifted_bits\": session[\"sifted_bits\"],\n",
        "\n",
        "            \"sample_size\": session[\"sample_size\"],\n",
        "\n",
        "            \"remaining_bits\": session[\"remaining_bits\"],\n",
        "\n",
        "            \"corrected_errors\":\n",
        "                session[\"corrected_errors\"],\n",
        "\n",
        "            \"leakage_bits\":\n",
        "                session[\"leakage_bits\"],\n",
        "\n",
        "            \"estimated_key_length\":\n",
        "                session[\"estimated_key_length\"],\n",
        "\n",
        "            \"final_key_length\":\n",
        "                session[\"final_key_length\"],\n",
        "\n",
        "            \"batch_count\":\n",
        "                session[\"metrics\"][\"batch_count\"],\n",
        "\n",
        "            \"average_circuit_depth\":\n",
        "                session[\"metrics\"][\"average_circuit_depth\"],\n",
        "\n",
        "            \"execution_time_seconds\":\n",
        "                session[\"metrics\"][\"execution_time_seconds\"]\n",
        "        })\n",
        "\n",
        "        print(\"QBER:\", round(session[\"qber\"], 5))\n",
        "\n",
        "        print(\n",
        "            \"Sifted bits:\",\n",
        "            session[\"sifted_bits\"]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"Estimated key length:\",\n",
        "            session[\"estimated_key_length\"]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"Final key length:\",\n",
        "            session[\"final_key_length\"]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"Message delivered:\",\n",
        "            delivery_success\n",
        "        )\n",
        "\n",
        "        print(\"\\nDecrypted message:\")\n",
        "        print(decrypted_message)\n",
        "\n",
        "    except Exception as error:\n",
        "\n",
        "        print(\"MESSAGE SESSION FAILED:\", str(error))\n",
        "\n",
        "        message_delivery_results.append({\n",
        "\n",
        "            \"processor\": processor_name,\n",
        "\n",
        "            \"message_characters\": len(USER_MESSAGE),\n",
        "\n",
        "            \"message_bytes\": len(\n",
        "                USER_MESSAGE.encode(\"utf-8\")\n",
        "            ),\n",
        "\n",
        "            \"ciphertext_bytes\": None,\n",
        "\n",
        "            \"encryption\": \"AES-256-GCM\",\n",
        "\n",
        "            \"key_length_bits\": 0,\n",
        "\n",
        "            \"qber\": None,\n",
        "\n",
        "            \"delivery_success\": False,\n",
        "\n",
        "            \"authentication_success\": False,\n",
        "\n",
        "            \"key_confirmation\": False,\n",
        "\n",
        "            \"error\": str(error)\n",
        "        })\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 22. PROCESSOR COMPARISON EXPERIMENT\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"PROCESSOR COMPARISON EXPERIMENT\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "trial_records = []\n",
        "failure_records = []\n",
        "\n",
        "for processor_name, processor in processors.items():\n",
        "\n",
        "    # Compare the same controlled model against each\n",
        "    # processor's own configured noise model.\n",
        "    noise_modes = {\n",
        "\n",
        "        \"Controlled Noise\": CONTROLLED_NOISE_MODEL,\n",
        "\n",
        "        \"Native Noise\": processor[\"noise_model\"]\n",
        "    }\n",
        "\n",
        "    for noise_mode, selected_noise_model in noise_modes.items():\n",
        "\n",
        "        print(\n",
        "            f\"\\n{processor_name} | {noise_mode}\"\n",
        "        )\n",
        "\n",
        "        for trial_number in range(\n",
        "            1,\n",
        "            COMPARISON_TRIALS + 1\n",
        "        ):\n",
        "\n",
        "            print(\n",
        "                f\"Trial {trial_number}/{COMPARISON_TRIALS}\"\n",
        "            )\n",
        "\n",
        "            try:\n",
        "\n",
        "                session = run_qkd_session(\n",
        "                    processor,\n",
        "                    COMPARISON_BITS,\n",
        "                    selected_noise_model\n",
        "                )\n",
        "\n",
        "                metrics = session[\"metrics\"]\n",
        "\n",
        "                trial_records.append({\n",
        "\n",
        "                    \"processor\": processor_name,\n",
        "\n",
        "                    \"noise_mode\": noise_mode,\n",
        "\n",
        "                    \"trial\": trial_number,\n",
        "\n",
        "                    \"qubits\": processor[\"qubits\"],\n",
        "\n",
        "                    \"qber\": session[\"qber\"],\n",
        "\n",
        "                    \"sifted_bits\":\n",
        "                        session[\"sifted_bits\"],\n",
        "\n",
        "                    \"sample_size\":\n",
        "                        session[\"sample_size\"],\n",
        "\n",
        "                    \"remaining_bits\":\n",
        "                        session[\"remaining_bits\"],\n",
        "\n",
        "                    \"corrected_errors\":\n",
        "                        session[\"corrected_errors\"],\n",
        "\n",
        "                    \"leakage_bits\":\n",
        "                        session[\"leakage_bits\"],\n",
        "\n",
        "                    \"estimated_key_length\":\n",
        "                        session[\"estimated_key_length\"],\n",
        "\n",
        "                    \"final_key_length\":\n",
        "                        session[\"final_key_length\"],\n",
        "\n",
        "                    \"batch_count\":\n",
        "                        metrics[\"batch_count\"],\n",
        "\n",
        "                    \"average_circuit_depth\":\n",
        "                        metrics[\"average_circuit_depth\"],\n",
        "\n",
        "                    \"one_qubit_gate_count\":\n",
        "                        metrics[\"one_qubit_gate_count\"],\n",
        "\n",
        "                    \"two_qubit_gate_count\":\n",
        "                        metrics[\"two_qubit_gate_count\"],\n",
        "\n",
        "                    \"total_gate_count\":\n",
        "                        metrics[\"total_gate_count\"],\n",
        "\n",
        "                    \"execution_time_seconds\":\n",
        "                        metrics[\"execution_time_seconds\"],\n",
        "\n",
        "                    \"success\": True,\n",
        "\n",
        "                    \"error\": None\n",
        "                })\n",
        "\n",
        "                print(\n",
        "                    \"QBER:\",\n",
        "                    round(session[\"qber\"], 5)\n",
        "                )\n",
        "\n",
        "                print(\n",
        "                    \"Final key:\",\n",
        "                    session[\"final_key_length\"],\n",
        "                    \"bits\"\n",
        "                )\n",
        "\n",
        "            except Exception as error:\n",
        "\n",
        "                failure_records.append({\n",
        "\n",
        "                    \"processor\": processor_name,\n",
        "\n",
        "                    \"noise_mode\": noise_mode,\n",
        "\n",
        "                    \"trial\": trial_number,\n",
        "\n",
        "                    \"error\": str(error)\n",
        "                })\n",
        "\n",
        "                print(\n",
        "                    \"TRIAL FAILED:\",\n",
        "                    str(error)\n",
        "                )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 23. CREATE DATAFRAMES\n",
        "# ================================================================\n",
        "\n",
        "trial_df = pd.DataFrame(\n",
        "    trial_records\n",
        ")\n",
        "\n",
        "failure_df = pd.DataFrame(\n",
        "    failure_records\n",
        ")\n",
        "\n",
        "delivery_df = pd.DataFrame(\n",
        "    message_delivery_results\n",
        ")\n",
        "\n",
        "message_summary_df = pd.DataFrame(\n",
        "    message_session_summary\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 24. PROCESSOR SUMMARY\n",
        "# ================================================================\n",
        "\n",
        "if not trial_df.empty:\n",
        "\n",
        "    processor_summary_df = (\n",
        "        trial_df\n",
        "        .groupby(\n",
        "            [\"processor\", \"noise_mode\"],\n",
        "            as_index=False\n",
        "        )\n",
        "        .agg({\n",
        "\n",
        "            \"qber\": \"mean\",\n",
        "\n",
        "            \"sifted_bits\": \"mean\",\n",
        "\n",
        "            \"corrected_errors\": \"mean\",\n",
        "\n",
        "            \"estimated_key_length\": \"mean\",\n",
        "\n",
        "            \"final_key_length\": \"mean\",\n",
        "\n",
        "            \"batch_count\": \"mean\",\n",
        "\n",
        "            \"average_circuit_depth\": \"mean\",\n",
        "\n",
        "            \"one_qubit_gate_count\": \"mean\",\n",
        "\n",
        "            \"two_qubit_gate_count\": \"mean\",\n",
        "\n",
        "            \"total_gate_count\": \"mean\",\n",
        "\n",
        "            \"execution_time_seconds\": \"mean\",\n",
        "\n",
        "            \"success\": \"sum\"\n",
        "        })\n",
        "    )\n",
        "\n",
        "else:\n",
        "\n",
        "    processor_summary_df = pd.DataFrame()\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 25. ARCHITECTURE SUMMARY\n",
        "# ================================================================\n",
        "\n",
        "architecture_records = []\n",
        "\n",
        "for processor_name, processor in processors.items():\n",
        "\n",
        "    architecture_records.append({\n",
        "\n",
        "        \"processor\": processor_name,\n",
        "\n",
        "        \"backend_name\": processor[\"name\"],\n",
        "\n",
        "        \"available_qubits\": processor[\"qubits\"],\n",
        "\n",
        "        \"batch_capacity\": processor[\"qubits\"],\n",
        "\n",
        "        \"message_bits\": MESSAGE_BITS,\n",
        "\n",
        "        \"comparison_bits\": COMPARISON_BITS,\n",
        "\n",
        "        \"comparison_trials\": COMPARISON_TRIALS,\n",
        "\n",
        "        \"circuit_type\": \"Independent single-qubit BB84\",\n",
        "\n",
        "        \"two_qubit_operations_expected\": 0,\n",
        "\n",
        "        \"architecture_note\": (\n",
        "            \"Independent single-qubit circuits. \"\n",
        "            \"This experiment does not benchmark entangling gates \"\n",
        "            \"or multi-qubit connectivity.\"\n",
        "        )\n",
        "    })\n",
        "\n",
        "architecture_df = pd.DataFrame(\n",
        "    architecture_records\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 26. SAVE CSV DATASETS\n",
        "# ================================================================\n",
        "\n",
        "csv_outputs = {\n",
        "\n",
        "    \"message_delivery_results.csv\":\n",
        "        delivery_df,\n",
        "\n",
        "    \"message_session_summary.csv\":\n",
        "        message_summary_df,\n",
        "\n",
        "    \"processor_trial_data.csv\":\n",
        "        trial_df,\n",
        "\n",
        "    \"processor_trial_failures.csv\":\n",
        "        failure_df,\n",
        "\n",
        "    \"processor_summary.csv\":\n",
        "        processor_summary_df,\n",
        "\n",
        "    \"architecture_summary.csv\":\n",
        "        architecture_df\n",
        "}\n",
        "\n",
        "for filename, dataframe in csv_outputs.items():\n",
        "\n",
        "    output_path = os.path.join(\n",
        "        TABLES_DIR,\n",
        "        filename\n",
        "    )\n",
        "\n",
        "    dataframe.to_csv(\n",
        "        output_path,\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    print(\"Saved:\", output_path)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 27. GRAPH GENERATION FUNCTION\n",
        "# ================================================================\n",
        "\n",
        "def save_comparison_plot(\n",
        "    dataframe,\n",
        "    metric,\n",
        "    title,\n",
        "    ylabel,\n",
        "    filename\n",
        "):\n",
        "\n",
        "    if dataframe.empty:\n",
        "        print(\n",
        "            \"No successful data available for:\",\n",
        "            filename\n",
        "        )\n",
        "        return\n",
        "\n",
        "    if metric not in dataframe.columns:\n",
        "        return\n",
        "\n",
        "    grouped = (\n",
        "        dataframe\n",
        "        .groupby(\n",
        "            [\"processor\", \"noise_mode\"]\n",
        "        )[metric]\n",
        "        .mean()\n",
        "        .unstack()\n",
        "    )\n",
        "\n",
        "    ax = grouped.plot(\n",
        "        kind=\"bar\",\n",
        "        figsize=(9, 5)\n",
        "    )\n",
        "\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"Processor\")\n",
        "    ax.set_ylabel(ylabel)\n",
        "\n",
        "    ax.grid(\n",
        "        axis=\"y\",\n",
        "        alpha=0.3\n",
        "    )\n",
        "\n",
        "    plt.xticks(rotation=0)\n",
        "    plt.tight_layout()\n",
        "\n",
        "    output_path = os.path.join(\n",
        "        FIGURES_DIR,\n",
        "        filename + \".png\"\n",
        "    )\n",
        "\n",
        "    plt.savefig(\n",
        "        output_path,\n",
        "        dpi=300,\n",
        "        bbox_inches=\"tight\"\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "    plt.close()\n",
        "\n",
        "    print(\"Saved:\", output_path)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 28. GENERATE COMPARISON GRAPHS\n",
        "# ================================================================\n",
        "\n",
        "save_comparison_plot(\n",
        "    trial_df,\n",
        "    \"qber\",\n",
        "    \"QBER Comparison: Processor A vs Processor B\",\n",
        "    \"Quantum Bit Error Rate\",\n",
        "    \"qber_comparison\"\n",
        ")\n",
        "\n",
        "save_comparison_plot(\n",
        "    trial_df,\n",
        "    \"sifted_bits\",\n",
        "    \"Sifted Bits Comparison\",\n",
        "    \"Sifted Bits\",\n",
        "    \"sifted_bits_comparison\"\n",
        ")\n",
        "\n",
        "save_comparison_plot(\n",
        "    trial_df,\n",
        "    \"final_key_length\",\n",
        "    \"Final Key Length Comparison\",\n",
        "    \"Final Key Length (bits)\",\n",
        "    \"final_key_length_comparison\"\n",
        ")\n",
        "\n",
        "save_comparison_plot(\n",
        "    trial_df,\n",
        "    \"average_circuit_depth\",\n",
        "    \"Average Circuit Depth Comparison\",\n",
        "    \"Average Circuit Depth\",\n",
        "    \"circuit_depth_comparison\"\n",
        ")\n",
        "\n",
        "save_comparison_plot(\n",
        "    trial_df,\n",
        "    \"one_qubit_gate_count\",\n",
        "    \"One-Qubit Gate Count Comparison\",\n",
        "    \"One-Qubit Gates\",\n",
        "    \"gate_count_comparison\"\n",
        ")\n",
        "\n",
        "save_comparison_plot(\n",
        "    trial_df,\n",
        "    \"batch_count\",\n",
        "    \"Batch Count Comparison\",\n",
        "    \"Number of Batches\",\n",
        "    \"batch_count_comparison\"\n",
        ")\n",
        "\n",
        "save_comparison_plot(\n",
        "    trial_df,\n",
        "    \"corrected_errors\",\n",
        "    \"Corrected Errors Comparison\",\n",
        "    \"Corrected Errors\",\n",
        "    \"corrected_errors_comparison\"\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 29. PROCESSOR DASHBOARD\n",
        "# ================================================================\n",
        "\n",
        "if not trial_df.empty:\n",
        "\n",
        "    dashboard_metrics = [\n",
        "\n",
        "        (\"qber\", \"Average QBER\"),\n",
        "\n",
        "        (\"sifted_bits\", \"Average Sifted Bits\"),\n",
        "\n",
        "        (\"final_key_length\", \"Average Final Key Length\"),\n",
        "\n",
        "        (\"average_circuit_depth\", \"Average Circuit Depth\"),\n",
        "\n",
        "        (\"batch_count\", \"Average Batch Count\"),\n",
        "\n",
        "        (\"execution_time_seconds\", \"Average Execution Time\")\n",
        "    ]\n",
        "\n",
        "    fig, axes = plt.subplots(\n",
        "        2,\n",
        "        3,\n",
        "        figsize=(16, 9)\n",
        "    )\n",
        "\n",
        "    axes = axes.flatten()\n",
        "\n",
        "    for index, (metric, title) in enumerate(\n",
        "        dashboard_metrics\n",
        "    ):\n",
        "\n",
        "        grouped = (\n",
        "            trial_df\n",
        "            .groupby(\n",
        "                [\"processor\", \"noise_mode\"]\n",
        "            )[metric]\n",
        "            .mean()\n",
        "            .unstack()\n",
        "        )\n",
        "\n",
        "        grouped.plot(\n",
        "            kind=\"bar\",\n",
        "            ax=axes[index]\n",
        "        )\n",
        "\n",
        "        axes[index].set_title(title)\n",
        "        axes[index].set_xlabel(\"Processor\")\n",
        "\n",
        "        axes[index].grid(\n",
        "            axis=\"y\",\n",
        "            alpha=0.3\n",
        "        )\n",
        "\n",
        "        axes[index].tick_params(\n",
        "            axis=\"x\",\n",
        "            rotation=0\n",
        "        )\n",
        "\n",
        "    plt.suptitle(\n",
        "        \"Quantum Secure Channel: Processor Comparison\",\n",
        "        fontsize=15\n",
        "    )\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    dashboard_path = os.path.join(\n",
        "        FIGURES_DIR,\n",
        "        \"processor_dashboard.png\"\n",
        "    )\n",
        "\n",
        "    plt.savefig(\n",
        "        dashboard_path,\n",
        "        dpi=300,\n",
        "        bbox_inches=\"tight\"\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "    plt.close()\n",
        "\n",
        "    print(\"Saved:\", dashboard_path)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 30. SECURITY REPORT\n",
        "# ================================================================\n",
        "\n",
        "security_report = {\n",
        "\n",
        "    \"project\": \"Quantum Secure Channel\",\n",
        "\n",
        "    \"protocol\": \"BB84\",\n",
        "\n",
        "    \"privacy_amplification\": \"Toeplitz Hashing\",\n",
        "\n",
        "    \"encryption\": \"AES-256-GCM\",\n",
        "\n",
        "    \"authentication_demonstration\": \"HMAC-SHA256\",\n",
        "\n",
        "    \"processors\": {\n",
        "\n",
        "        processor_name: {\n",
        "\n",
        "            \"backend\": processor[\"name\"],\n",
        "\n",
        "            \"qubits\": processor[\"qubits\"]\n",
        "\n",
        "        }\n",
        "\n",
        "        for processor_name, processor in processors.items()\n",
        "    },\n",
        "\n",
        "    \"configuration\": {\n",
        "\n",
        "        \"message_bits\": MESSAGE_BITS,\n",
        "\n",
        "        \"comparison_bits\": COMPARISON_BITS,\n",
        "\n",
        "        \"comparison_trials\": COMPARISON_TRIALS,\n",
        "\n",
        "        \"test_fraction\": TEST_FRACTION,\n",
        "\n",
        "        \"qber_abort_threshold\":\n",
        "            QBER_ABORT_THRESHOLD,\n",
        "\n",
        "        \"aes_key_bits\": AES_KEY_BITS\n",
        "    },\n",
        "\n",
        "    \"message_delivery\": (\n",
        "        delivery_df.to_dict(orient=\"records\")\n",
        "        if not delivery_df.empty\n",
        "        else []\n",
        "    ),\n",
        "\n",
        "    \"message_sessions\": (\n",
        "        message_summary_df.to_dict(orient=\"records\")\n",
        "        if not message_summary_df.empty\n",
        "        else []\n",
        "    ),\n",
        "\n",
        "    \"comparison_summary\": (\n",
        "        processor_summary_df.to_dict(orient=\"records\")\n",
        "        if not processor_summary_df.empty\n",
        "        else []\n",
        "    ),\n",
        "\n",
        "    \"successful_trial_count\": len(trial_df),\n",
        "\n",
        "    \"failed_trial_count\": len(failure_df),\n",
        "\n",
        "    \"limitations\": [\n",
        "\n",
        "        \"Educational simulation; not production-certified QKD.\",\n",
        "\n",
        "        \"The reconciliation procedure is a simplified \"\n",
        "        \"disclosure-based demonstration, not Cascade.\",\n",
        "\n",
        "        \"The final key length uses a heuristic estimate, \"\n",
        "        \"not a finite-key or composable security proof.\",\n",
        "\n",
        "        \"The authentication PSK is generated locally \"\n",
        "        \"for this demonstration.\",\n",
        "\n",
        "        \"The controlled noise model is synthetic.\",\n",
        "\n",
        "        \"Native noise results depend on the supplied \"\n",
        "        \"processor noise models.\",\n",
        "\n",
        "        \"AES-256-GCM is classical encryption using \"\n",
        "        \"a key derived from the simulated QKD process.\",\n",
        "\n",
        "        \"Independent single-qubit circuits do not provide \"\n",
        "        \"a meaningful benchmark of multi-qubit connectivity.\"\n",
        "    ],\n",
        "\n",
        "    \"generated_at_utc\": datetime.now(\n",
        "        timezone.utc\n",
        "    ).isoformat()\n",
        "}\n",
        "\n",
        "report_path = os.path.join(\n",
        "    RESULTS_DIR,\n",
        "    \"security_report.json\"\n",
        ")\n",
        "\n",
        "with open(\n",
        "    report_path,\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as report_file:\n",
        "\n",
        "    json.dump(\n",
        "        security_report,\n",
        "        report_file,\n",
        "        indent=4,\n",
        "        default=str\n",
        "    )\n",
        "\n",
        "print(\"Saved:\", report_path)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 31. DISPLAY RESULTS\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"MESSAGE DELIVERY RESULTS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "if not delivery_df.empty:\n",
        "    display(delivery_df)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"MESSAGE SESSION SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "if not message_summary_df.empty:\n",
        "    display(message_summary_df)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"PROCESSOR COMPARISON SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "if not processor_summary_df.empty:\n",
        "    display(processor_summary_df)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"ARCHITECTURE SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "display(architecture_df)\n",
        "\n",
        "if not failure_df.empty:\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"FAILED TRIALS\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    display(failure_df)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 32. FINAL DIRECTORY LISTING\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"GENERATED FILES\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "for directory in [\n",
        "    RESULTS_DIR,\n",
        "    FIGURES_DIR,\n",
        "    TABLES_DIR\n",
        "]:\n",
        "\n",
        "    print(f\"\\n{directory}/\")\n",
        "\n",
        "    for filename in sorted(\n",
        "        os.listdir(directory)\n",
        "    ):\n",
        "\n",
        "        file_path = os.path.join(\n",
        "            directory,\n",
        "            filename\n",
        "        )\n",
        "\n",
        "        if os.path.isfile(file_path):\n",
        "            print(\"   \", filename)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 33. COMPLETION SUMMARY\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"EXPERIMENT COMPLETED\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    \"Successful comparison trials:\",\n",
        "    len(trial_df)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Failed comparison trials:\",\n",
        "    len(failure_df)\n",
        ")\n",
        "\n",
        "if not delivery_df.empty:\n",
        "\n",
        "    successful_deliveries = int(\n",
        "        delivery_df[\"delivery_success\"].sum()\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Successful message deliveries:\",\n",
        "        successful_deliveries,\n",
        "        \"/\",\n",
        "        len(delivery_df)\n",
        "    )\n",
        "\n",
        "print(\"\\nPNG files:\", FIGURES_DIR)\n",
        "print(\"CSV files:\", TABLES_DIR)\n",
        "print(\"JSON report:\", report_path)\n",
        "\n",
        "print(\"\\nAll available results have been saved.\")"
      ]
    },
   
