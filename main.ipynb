# ================================================================
# 5. CONTROLLED NOISE MODEL
# ================================================================

def get_controlled_noise_model():

    noise_model = NoiseModel()

    single_qubit_error = depolarizing_error(
        0.005,
        1
    )

    readout_error = ReadoutError([
        [0.98, 0.02],
        [0.02, 0.98]
    ])

    for gate in ["x", "sx", "h"]:

        noise_model.add_all_qubit_quantum_error(
            single_qubit_error,
            gate
        )

    noise_model.add_all_qubit_readout_error(
        readout_error
    )

    return noise_model


CONTROLLED_NOISE_MODEL = get_controlled_noise_model()


# ================================================================
# 6. GENERAL HELPER FUNCTIONS
# ================================================================

def binary_entropy(probability):

    if probability <= 0 or probability >= 1:
        return 0.0

    return (
        -probability * np.log2(probability)
        -(1 - probability) * np.log2(1 - probability)
    )


def calculate_qber(alice_bits, bob_bits):

    if len(alice_bits) == 0:
        raise ValueError("Cannot calculate QBER from zero bits.")

    errors = np.sum(
        np.asarray(alice_bits) != np.asarray(bob_bits)
    )

    return float(errors / len(alice_bits))


def pack_key_bits(key_bits):

    key_bits = np.asarray(
        key_bits,
        dtype=np.uint8
    ).reshape(-1)

    if len(key_bits) != AES_KEY_BITS:
        raise ValueError(
            f"AES-256 requires {AES_KEY_BITS} bits. "
            f"Received {len(key_bits)}."
        )

    if not np.all(
        (key_bits == 0) | (key_bits == 1)
    ):
        raise ValueError(
            "Key contains non-binary values."
        )

    packed_key = np.packbits(
        key_bits
    ).tobytes()

    if len(packed_key) != AES_KEY_BYTES:
        raise ValueError(
            "Packed key is not exactly 32 bytes."
        )

    return packed_key


# ================================================================
# 7. BB84 CIRCUIT GENERATION
# ================================================================

def generate_bb84_circuit(
    alice_bits,
    alice_bases,
    bob_bases
):

    number_of_qubits = len(alice_bits)

    circuit = QuantumCircuit(
        number_of_qubits,
        number_of_qubits
    )

    for i in range(number_of_qubits):

        if alice_bits[i] == 1:
            circuit.x(i)

        if alice_bases[i] == 1:
            circuit.h(i)

        if bob_bases[i] == 1:
            circuit.h(i)

        circuit.measure(i, i)

    return circuit


# ================================================================
# 8. QUANTUM TRANSMISSION
# ================================================================

def transmit_bb84(
    processor,
    number_of_bits,
    noise_model=None
):

    start_time = time.perf_counter()

    processor_qubits = int(
        processor["qubits"]
    )

    backend = processor["backend"]

    alice_bits = rng.integers(
        0,
        2,
        size=number_of_bits,
        dtype=np.uint8
    )

    alice_bases = rng.integers(
        0,
        2,
        size=number_of_bits,
        dtype=np.uint8
    )

    bob_bases = rng.integers(
        0,
        2,
        size=number_of_bits,
        dtype=np.uint8
    )

    circuits = []

    for start in range(
        0,
        number_of_bits,
        processor_qubits
    ):

        end = min(
            start + processor_qubits,
            number_of_bits
        )

        circuit = generate_bb84_circuit(
            alice_bits[start:end],
            alice_bases[start:end],
            bob_bases[start:end]
        )

        circuits.append(circuit)

    batch_count = len(circuits)

    transpiled_circuits = transpile(
        circuits,
        backend=backend,
        optimization_level=1
    )

    if not isinstance(transpiled_circuits, list):
        transpiled_circuits = [transpiled_circuits]

    simulator = AerSimulator(
        noise_model=noise_model
    )

    job = simulator.run(
        transpiled_circuits,
        shots=1
    )

    result = job.result()

    bob_bits = []

    total_depth = 0
    total_one_qubit_gates = 0
    total_two_qubit_gates = 0
    total_gate_count = 0

    for circuit_index, circuit in enumerate(
        transpiled_circuits
    ):

        counts = result.get_counts(
            circuit_index
        )

        measured_string = next(
            iter(counts)
        )

        measured_string = (
            measured_string
            .replace(" ", "")
            [::-1]
        )

        circuit_bits = [
            int(bit)
            for bit in measured_string
        ]

        if len(circuit_bits) != circuit.num_clbits:
            raise ValueError(
                "Measurement result length does not match "
                "the circuit's classical register."
            )

        bob_bits.extend(circuit_bits)

        total_depth += circuit.depth()

        operations = circuit.count_ops()

        for operation, count in operations.items():

            operation = str(operation)

            if operation in [
                "measure",
                "barrier",
                "delay"
            ]:
                continue

            total_gate_count += count

            if operation in [
                "x",
                "sx",
                "h",
                "rz",
                "u",
                "u1",
                "u2",
                "u3"
            ]:

                total_one_qubit_gates += count

            elif operation in [
                "cx",
                "cz",
                "ecr",
                "swap",
                "iswap"
            ]:

                total_two_qubit_gates += count

    bob_bits = np.asarray(
        bob_bits[:number_of_bits],
        dtype=np.uint8
    )

    if len(bob_bits) != number_of_bits:
        raise ValueError(
            "Bob's measurement output has an unexpected length."
        )

    elapsed_time = (
        time.perf_counter() - start_time
    )

    metrics = {

        "batch_count": batch_count,

        "average_circuit_depth":
            total_depth / max(batch_count, 1),

        "one_qubit_gate_count":
            total_one_qubit_gates,

        "two_qubit_gate_count":
            total_two_qubit_gates,

        "total_gate_count":
            total_gate_count,

        "execution_time_seconds":
            elapsed_time
    }

    return {

        "alice_bits": alice_bits,

        "alice_bases": alice_bases,

        "bob_bases": bob_bases,

        "bob_bits": bob_bits,

        "metrics": metrics
    }


# ================================================================
# 9. BB84 SIFTING
# ================================================================

def sift_key(
    alice_bits,
    alice_bases,
    bob_bases,
    bob_bits
):

    matching_positions = np.where(
        alice_bases == bob_bases
    )[0]

    sifted_alice = alice_bits[
        matching_positions
    ]

    sifted_bob = bob_bits[
        matching_positions
    ]

    return (
        sifted_alice,
        sifted_bob,
        matching_positions
    )


# ================================================================
# 10. QBER ESTIMATION
# ================================================================

def estimate_qber(
    alice_bits,
    bob_bits,
    test_fraction=TEST_FRACTION
):

    total_bits = len(alice_bits)

    if total_bits < 10:
        raise ValueError(
            "Insufficient sifted bits for QBER estimation."
        )

    sample_size = max(
        1,
        int(total_bits * test_fraction)
    )

    sample_indices = rng.choice(
        total_bits,
        size=sample_size,
        replace=False
    )

    remaining_mask = np.ones(
        total_bits,
        dtype=bool
    )

    remaining_mask[sample_indices] = False

    sample_alice = alice_bits[
        sample_indices
    ]

    sample_bob = bob_bits[
        sample_indices
    ]

    qber = calculate_qber(
        sample_alice,
        sample_bob
    )

    remaining_alice = alice_bits[
        remaining_mask
    ]

    remaining_bob = bob_bits[
        remaining_mask
    ]

    return {

        "qber": qber,

        "sample_size": sample_size,

        "remaining_alice": remaining_alice,

        "remaining_bob": remaining_bob
    }


# ================================================================
# 11. EDUCATIONAL ERROR RECONCILIATION
# ================================================================

def reconcile_keys(
    alice_bits,
    bob_bits
):

    alice_bits = np.asarray(
        alice_bits,
        dtype=np.uint8
    ).copy()

    bob_bits = np.asarray(
        bob_bits,
        dtype=np.uint8
    ).copy()

    if len(alice_bits) != len(bob_bits):
        raise ValueError(
            "Alice and Bob key lengths differ."
        )

    mismatch_positions = np.where(
        alice_bits != bob_bits
    )[0]

    corrected_bob = bob_bits.copy()

    for position in mismatch_positions:

        corrected_bob[position] = alice_bits[position]

    if not np.array_equal(
        alice_bits,
        corrected_bob
    ):
        raise ValueError(
            "Error reconciliation did not produce matching strings."
        )

    return {

        "alice_key": alice_bits,

        "bob_key": corrected_bob,

        "corrected_errors": len(mismatch_positions),

        "leakage_bits": len(mismatch_positions)
    }


# ================================================================
# 12. TOEPLITZ PRIVACY AMPLIFICATION
# ================================================================

def toeplitz_hash(
    input_bits,
    output_length=AES_KEY_BITS,
    seed=None
):

    input_bits = np.asarray(
        input_bits,
        dtype=np.uint8
    ).reshape(-1)

    n = len(input_bits)
    m = int(output_length)

    if n < m:
        raise ValueError(
            f"Input too short: {n} bits available; "
            f"{m} bits required."
        )

    seed_length = n + m - 1

    if seed is None:

        seed = rng.integers(
            0,
            2,
            size=seed_length,
            dtype=np.uint8
        )

    seed = np.asarray(
        seed,
        dtype=np.uint8
    ).reshape(-1)

    if len(seed) != seed_length:
        raise ValueError(
            f"Invalid Toeplitz seed length: {len(seed)}. "
            f"Expected {seed_length}."
        )

    if not np.all(
        (seed == 0) | (seed == 1)
    ):
        raise ValueError(
            "Toeplitz seed must contain only binary values."
        )

    row_indices = np.arange(m).reshape(m, 1)

    column_indices = np.arange(n).reshape(1, n)

    indices = (
        n - 1
        + row_indices
        - column_indices
    )

    if (
        indices.min() < 0
        or indices.max() >= len(seed)
    ):

        raise RuntimeError(
            "Toeplitz indexing error: "
            f"min={indices.min()}, "
            f"max={indices.max()}, "
            f"seed length={len(seed)}."
        )

    matrix = seed[indices]

    output_bits = (
        matrix.astype(np.int64)
        @ input_bits.astype(np.int64)
    ) % 2

    return output_bits.astype(np.uint8)


# ================================================================
# 13. FINAL KEY LENGTH ESTIMATION
# ================================================================

def estimate_final_key_length(
    remaining_bits,
    qber,
    leakage_bits
):

    entropy = binary_entropy(qber)

    estimated_length = (
        remaining_bits
        - 2 * remaining_bits * entropy
        - leakage_bits
        - 128
    )

    return max(
        0,
        int(np.floor(estimated_length))
    )


# ================================================================
# 14. TRANSCRIPT AUTHENTICATION DEMONSTRATION
# ================================================================

def authenticate_transcript(transcript):

    transcript_bytes = transcript.encode(
        "utf-8"
    )

    tag = hmac.new(
        AUTH_PSK,
        transcript_bytes,
        hashlib.sha256
    ).digest()

    verification_tag = hmac.new(
        AUTH_PSK,
        transcript_bytes,
        hashlib.sha256
    ).digest()

    return hmac.compare_digest(
        tag,
        verification_tag
    )


# ================================================================
# 15. FINAL KEY CONFIRMATION
# ================================================================

def confirm_final_keys(
    alice_key_bits,
    bob_key_bits
):

    alice_key = pack_key_bits(
        alice_key_bits
    )

    bob_key = pack_key_bits(
        bob_key_bits
    )

    alice_confirmation = hmac.new(
        alice_key,
        b"BB84-key-confirmation",
        hashlib.sha256
    ).digest()

    bob_confirmation = hmac.new(
        bob_key,
        b"BB84-key-confirmation",
        hashlib.sha256
    ).digest()

    return hmac.compare_digest(
        alice_confirmation,
        bob_confirmation
    )


# ================================================================
# 16. AES-256-GCM ENCRYPTION
# ================================================================

def encrypt_message(
    message,
    key_bits
):

    key = pack_key_bits(
        key_bits
    )

    aesgcm = AESGCM(key)

    nonce = secrets.token_bytes(12)

    ciphertext = aesgcm.encrypt(
        nonce,
        message.encode("utf-8"),
        None
    )

    return {

        "nonce": nonce,

        "ciphertext": ciphertext
    }


# ================================================================
# 17. AES-256-GCM DECRYPTION
# ================================================================

def decrypt_message(
    encrypted_data,
    key_bits
):

    key = pack_key_bits(
        key_bits
    )

    aesgcm = AESGCM(key)

    plaintext = aesgcm.decrypt(
        encrypted_data["nonce"],
        encrypted_data["ciphertext"],
        None
    )

    return plaintext.decode("utf-8")


# ================================================================
# 18. COMPLETE QKD SESSION
# ================================================================

def run_qkd_session(
    processor,
    number_of_bits,
    noise_model=None
):

    transmission = transmit_bb84(
        processor,
        number_of_bits,
        noise_model
    )

    sifted_alice, sifted_bob, matching_positions = (
        sift_key(
            transmission["alice_bits"],
            transmission["alice_bases"],
            transmission["bob_bases"],
            transmission["bob_bits"]
        )
    )

    if len(sifted_alice) < AES_KEY_BITS + 150:
        raise ValueError(
            "Insufficient sifted bits for key generation."
        )

    qber_result = estimate_qber(
        sifted_alice,
        sifted_bob
    )

    qber = qber_result["qber"]

    if qber > QBER_ABORT_THRESHOLD:
        raise ValueError(
            f"QBER {qber:.4f} exceeds threshold "
            f"{QBER_ABORT_THRESHOLD:.2f}."
        )

    remaining_alice = qber_result[
        "remaining_alice"
    ]

    remaining_bob = qber_result[
        "remaining_bob"
    ]

    reconciliation = reconcile_keys(
        remaining_alice,
        remaining_bob
    )

    alice_reconciled = reconciliation[
        "alice_key"
    ]

    bob_reconciled = reconciliation[
        "bob_key"
    ]

    if not np.array_equal(
        alice_reconciled,
        bob_reconciled
    ):
        raise ValueError(
            "Reconciliation failed: keys do not match."
        )

    estimated_key_length = estimate_final_key_length(
        len(alice_reconciled),
        qber,
        reconciliation["leakage_bits"]
    )

    if estimated_key_length < AES_KEY_BITS:
        raise ValueError(
            "Estimated secure key length is insufficient "
            f"({estimated_key_length} bits available; "
            f"{AES_KEY_BITS} required)."
        )

    # One shared public Toeplitz seed.
    input_length = len(alice_reconciled)

    toeplitz_seed = rng.integers(
        0,
        2,
        size=input_length + AES_KEY_BITS - 1,
        dtype=np.uint8
    )

    alice_final_key = toeplitz_hash(
        alice_reconciled,
        AES_KEY_BITS,
        seed=toeplitz_seed
    )

    bob_final_key = toeplitz_hash(
        bob_reconciled,
        AES_KEY_BITS,
        seed=toeplitz_seed
    )

    if not np.array_equal(
        alice_final_key,
        bob_final_key
    ):
        raise ValueError(
            "Privacy amplification failed: final keys differ."
        )

    key_confirmation = confirm_final_keys(
        alice_final_key,
        bob_final_key
    )

    if not key_confirmation:
        raise ValueError(
            "Alice and Bob final key confirmation failed."
        )

    transcript = (
        f"Processor={processor['name']};"
        f"QBER={qber:.6f};"
        f"Sifted={len(sifted_alice)};"
        f"FinalKey={AES_KEY_BITS}"
    )

    authentication_success = authenticate_transcript(
        transcript
    )

    if not authentication_success:
        raise ValueError(
            "Transcript authentication failed."
        )

    return {

        "qber": qber,

        "sifted_bits": len(sifted_alice),

        "sample_size": qber_result["sample_size"],

        "remaining_bits": len(alice_reconciled),

        "corrected_errors":
            reconciliation["corrected_errors"],

        "leakage_bits":
            reconciliation["leakage_bits"],

        "estimated_key_length":
            estimated_key_length,

        "final_key_length":
            len(alice_final_key),

        "alice_key": alice_final_key,

        "bob_key": bob_final_key,

        "key_confirmation": key_confirmation,

        "authentication_success":
            authentication_success,

        "metrics": transmission["metrics"]
    }


