# ================================================================
# 27. GRAPH GENERATION FUNCTION
# ================================================================

def save_comparison_plot(
    dataframe,
    metric,
    title,
    ylabel,
    filename
):

    if dataframe.empty:
        return

    if metric not in dataframe.columns:
        return

    grouped = (
        dataframe
        .groupby(
            ["processor", "noise_mode"]
        )[metric]
        .mean()
        .unstack()
    )

    ax = grouped.plot(
        kind="bar",
        figsize=(9, 5)
    )

    ax.set_title(title)
    ax.set_xlabel("Processor")
    ax.set_ylabel(ylabel)

    ax.grid(
        axis="y",
        alpha=0.3
    )

    plt.xticks(rotation=0)
    plt.tight_layout()

    output_path = os.path.join(
        FIGURES_DIR,
        filename + ".png"
    )

    plt.savefig(
        output_path,
        dpi=300,
        bbox_inches="tight"
    )

    plt.show()
    plt.close()


