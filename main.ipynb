        "Controlled Noise": CONTROLLED_NOISE_MODEL,

        "Native Noise": processor["noise_model"]
    }

    for noise_mode, selected_noise_model in noise_modes.items():

        print(
            f"\nRunning {processor_name} | {noise_mode}"
        )

        for trial_number in range(
            1,
            COMPARISON_TRIALS + 1
        ):

            try:

                session = run_qkd_session(
                    processor,
                    COMPARISON_BITS,
                    selected_noise_model
                )

                metrics = session["metrics"]

                trial_records.append({

                    "processor": processor_name,

                    "noise_mode": noise_mode,

                    "trial": trial_number,

                    "qubits": processor["qubits"],

                    "qber": session["qber"],

                    "sifted_bits":
                        session["sifted_bits"],

                    "sample_size":
                        session["sample_size"],

                    "remaining_bits":
                        session["remaining_bits"],

                    "corrected_errors":
                        session["corrected_errors"],

                    "leakage_bits":
                        session["leakage_bits"],

                    "estimated_key_length":
                        session["estimated_key_length"],

                    "final_key_length":
                        session["final_key_length"],

                    "batch_count":
                        metrics["batch_count"],

                    "average_circuit_depth":
                        metrics["average_circuit_depth"],

                    "one_qubit_gate_count":
                        metrics["one_qubit_gate_count"],

                    "two_qubit_gate_count":
                        metrics["two_qubit_gate_count"],

                    "total_gate_count":
                        metrics["total_gate_count"],

                    "execution_time_seconds":
                        metrics["execution_time_seconds"],

                    "success": True,

                    "error": None
                })

                print(
                    f"Trial {trial_number}: SUCCESS"
                )

            except Exception as error:

                failure_records.append({

                    "processor": processor_name,

                    "noise_mode": noise_mode,

                    "trial": trial_number,

                    "error": str(error)
                })

                print(
                    f"Trial {trial_number}: FAILED"
                )


